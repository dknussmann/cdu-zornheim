NEXT_PUBLIC_SITE_URL=https://cdu-zornheim.vercel.app
ADMIN_SESSION_SECRET=

# Database (Neon)
DATABASE_URL=

# Clerk (optional – when set, replaces magic-link login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated admin emails allowed to post
ADMIN_EMAILS=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# LaunchDarkly (Production client-side ID also for previews)
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_SIDE_ID=
LD_API_TOKEN=

# Slack: notify channel when a Vercel Preview is ready
# Preferred: Incoming Webhook for https://airbitgruppe.slack.com/archives/C0BM6R2K10E
SLACK_WEBHOOK_URL=
# Or Bot token (chat.postMessage) – default channel C0BM6R2K10E
SLACK_BOT_TOKEN=
SLACK_PREVIEW_CHANNEL_ID=C0BM6R2K10E
# Secret shown when creating the Vercel webhook (Team Settings → Webhooks)
VERCEL_WEBHOOK_SECRET=
