CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated admin emails allowed to post (required in production)
ADMIN_EMAILS=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# LaunchDarkly (Production client-side ID also for previews)
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_SIDE_ID=
LD_API_TOKEN=
