NEXT_PUBLIC_SITE_URL=https://cdu-zornheim.vercel.app
# Required in production for magic-link sessions
ADMIN_SESSION_SECRET=

# Database (Neon)
DATABASE_URL=

# Clerk (optional – when set, replaces magic-link login)
